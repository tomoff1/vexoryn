{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEXORYN",
  "version": "0.1.0",
  "identifier": "app.vexoryn.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VEXORYN — Console Suite",
        "width": 1440,
        "height": 950,
        "minWidth": 1050,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "VEXORYN",
    "category": "Utility",
    "shortDescription": "Gestion locale des consoles compatibles",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "French",
          "English"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": [
          "fr-FR",
          "en-US"
        ]
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    }
  }
}
